{
  "kind": "singleType",
  "collectionName": "ai_configs",
  "info": {
    "singularName": "ai-config",
    "pluralName": "ai-configs",
    "displayName": "AI 配置",
    "description": "LLM 接口配置（仅服务器读取，禁止 Public 访问）"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "llmApiKey": {
      "type": "text",
      "description": "API Key（仅服务器使用，不会通过公开 API 返回；请勿授予 Public 角色访问权限）"
    },
    "llmBaseUrl": {
      "type": "string",
      "default": "https://api.openai.com/v1"
    },
    "llmModel": {
      "type": "string",
      "default": "gpt-4o-mini"
    },
    "systemPrompt": {
      "type": "text"
    },
    "enableAi": {
      "type": "boolean",
      "default": false
    }
  }
}
