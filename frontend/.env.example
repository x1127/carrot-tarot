# AI 解读 LLM 配置（OpenAI 兼容接口）
# 复制本文件为 .env 并填入你的配置后即可启用 AI 解读功能
# 未配置时，AI 解读会优雅降级，仍可使用预设牌意

# 你的 API Key
LLM_API_KEY=

# 接口地址（默认 OpenAI；国内服务示例：
#   DeepSeek: https://api.deepseek.com/v1
#   通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
#   Moonshot: https://api.moonshot.cn/v1）
LLM_BASE_URL=https://api.openai.com/v1

# 模型名（如 gpt-4o-mini / deepseek-chat / qwen-plus / moonshot-v1-8k）
LLM_MODEL=gpt-4o-mini

# 后端端口
PORT=3001

# 前端构建期变量（Vite）：AI 解读 API 的基础地址
# 本地开发无需配置（留空走 Vite 代理到 localhost:3001）；
# 生产部署（Cloudflare Pages）构建时设置为 Worker 地址，例如：
#   VITE_API_BASE=https://api.example.com
#   或 https://carrot-tarot-api.<你的子域>.workers.dev
VITE_API_BASE=
